<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
  </head>

  <body class="bg-brand-bg min-h-screen font-body text-brand-text">
    <header class="bg-brand-surface border-b border-brand-borderLight px-4 py-4 sticky top-0 z-10">
      <h1 class="font-display font-bold text-lg text-brand-text">
        Saved Plants
      </h1>
    </header>

    <% if (!savedPlants || savedPlants.length === 0) { %>
      <main class="min-h-[calc(100vh-64px)] flex flex-col items-center justify-center px-8 text-center">
        <div
          class="w-16 h-16 rounded-2xl bg-[#EEEAE4] border border-brand-borderLight flex items-center justify-center mb-5"
        >
          <i class="fa-regular fa-bookmark text-2xl text-brand-muted"></i>
        </div>

        <h2 class="font-display font-bold text-lg text-brand-text mb-2">
          No saved plants yet
        </h2>

        <p class="text-sm text-brand-sub max-w-xs leading-relaxed mb-6">
          Explore the map and tap the bookmark icon to save plants you like
        </p>

        <a
          href="/map"
          class="text-brand-green font-semibold text-sm hover:text-brand-greenMid"
        >
          Explore map
          <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
      </main>
    <% } else { %>
      <main class="flex flex-col gap-4 p-4">
        <% savedPlants.forEach((plant) => { %>
          <%- include("partials/savedPlantCard", { plant: plant }) %>
        <% }) %>
      </main>
    <% } %>
    <%- include("partials/bottomnav") %>
  </body>
</html>