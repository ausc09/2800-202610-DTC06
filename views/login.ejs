<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log in · PlantSafe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              bg:          '#f7f5f0',
              surface:     '#ffffff',
              alt:         '#f0ede6',
              border:      '#e0dbd2',
              borderLight: '#eae6de',
              text:        '#1a1a16',
              sub:         '#6b6456',
              muted:       '#a89e90',
              green:       '#2d6a4f',
              greenMid:    '#40916c',
              greenPale:   '#e8f5ee',
              brown:       '#8c6a50',
              brownPale:   '#f5ede4',
              charcoal:    '#2a2620',
            }
          },
          fontFamily: {
            display: ["'Space Grotesk'", 'sans-serif'],
            body:    ["'DM Sans'", 'sans-serif'],
          },
          borderRadius: {
            card: '14px',
            chip: '20px',
            btn:  '13px',
          },
          boxShadow: {
            card: '0 2px 16px rgba(40,30,20,0.08)',
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-brand-bg min-h-screen flex items-center justify-center font-body">

  <div class="bg-brand-surface w-full min-h-screen flex flex-col justify-center px-8 py-10
              sm:min-h-fit sm:max-w-sm sm:rounded-card sm:shadow-card sm:flex-none">

    <!-- back button -->
   <button onclick="history.back()" class="text-brand-sub mb-6 block hover:text-brand-text transition">
    <i data-lucide="arrow-left" class="w-5 h-5"></i>
    </button>
    

    <!-- title -->
    <h1 class="font-display text-center font-bold text-brand-text text-2xl mb-8">Login account</h1>

    <!-- Email -->
    <div class="mb-4">
      <label class="block text-xs font-semibold text-brand-text tracking-widest mb-2">EMAIL</label>
      <input id="email" type="email" placeholder="Enter your email"
        class="w-full bg-brand-surface border border-brand-border rounded-xl px-4 py-3 text-brand-text placeholder:text-brand-muted text-sm focus:outline-none focus:border-brand-green">
    </div>

    <!-- Password -->
    <div class="mb-2">
      <label class="block text-xs font-semibold text-brand-text tracking-widest mb-2">PASSWORD</label>
      <input id="password" type="password" placeholder="Enter your password"
        class="w-full bg-brand-surface border border-brand-border rounded-xl px-4 py-3 text-brand-text placeholder:text-brand-muted text-sm focus:outline-none focus:border-brand-green">
    </div>

    <!-- Forgot password -->
    <div class="flex justify-end mb-6">
      <a href="/forgot-password" class="text-xs text-brand-sub hover:text-brand-green">Forgot password?</a>
    </div>

    <!-- Error -->
    <p id="err" class="text-red-500 text-sm mb-4 hidden"></p>

    <!-- Log in button -->
    <button onclick="login()"
      class="w-full bg-brand-charcoal text-white font-body font-semibold py-4 rounded-btn hover:bg-brand-green transition mb-4">
      Log In
    </button>

    <!-- Register link -->
    <p class="text-center text-sm text-brand-sub mb-6">
      Don't have an account?
      <a href="/signup" class="text-brand-text font-bold hover:text-brand-green">Register</a>
    </p>

    <!-- Divider -->
    <div class="flex items-center mb-4">
      <div class="flex-1 h-px bg-brand-border"></div>
      <span class="mx-3 text-xs text-brand-muted">or</span>
      <div class="flex-1 h-px bg-brand-border"></div>
    </div>

    <!-- Google -->
    <a href="/auth/google"
      class="w-full flex items-center justify-center gap-2 border border-brand-border rounded-btn py-3 text-sm text-brand-sub hover:bg-brand-alt transition">
      <svg width="18" height="18" viewBox="0 0 48 48">
        <path fill="#EA4335" d="M24 9.5c3.2 0 5.9 1.1 8.1 2.9l6-6C34.5 3.1 29.6 1 24 1 14.8 1 7 6.7 3.7 14.6l7 5.4C12.4 13.8 17.7 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.6 3-2.3 5.5-4.8 7.2l7.4 5.7c4.3-4 6.8-9.9 6.8-16.9z"/>
        <path fill="#FBBC05" d="M10.7 28.6A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.7-4.6l-7-5.4A23.5 23.5 0 0 0 .5 24c0 3.8.9 7.4 2.7 10.6l7.5-6z"/>
        <path fill="#34A853" d="M24 46.5c5.5 0 10.2-1.8 13.6-4.9l-7.4-5.7c-1.9 1.3-4.3 2-6.2 2-6.3 0-11.6-4.3-13.5-10l-7.5 6C7 41.5 14.9 46.5 24 46.5z"/>
      </svg>
      Continue with Google
    </a>

  </div>
  <script>lucide.createIcons();</script>
  <script src="/js/login.js"></script>
</body>
</html>