<!-- views/welcome.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head") %>
  <script>
    if (localStorage.getItem("onboarding_done")) {
      window.location.href = "/map";
    }
  </script>
</head>
<body class="bg-brand-bg font-body text-brand-text min-h-screen">

  <!-- Onboarding slides (first launch only) -->
  <%- include("partials/onboarding") %>

  <!-- Splash content -->
  <div class="min-h-screen flex flex-col items-center justify-between px-6 py-12">

    <!-- Top: Logo + description -->
    <div class="flex-1 flex flex-col items-center justify-center gap-6">

      <!-- SVG Logo -->
      <svg class="block mx-auto" width="280" height="80" viewBox="-5 0 286 80"
           xmlns="http://www.w3.org/2000/svg">
        <circle cx="40" cy="40" r="36" fill="#f5f0e8" stroke="#2d6a4f" stroke-width="2.5"/>
        <path d="M40 62C40 62 24 50 24 34C24 25 31 20 40 20C49 20 56 25 56 34C56 50 40 62 40 62Z" fill="#2d6a4f"/>
        <line x1="40" y1="62" x2="40" y2="20" stroke="#f5f0e8" stroke-width="2" stroke-linecap="round"/>
        <path d="M40 42C36 38 31 36 28 35" stroke="#f5f0e8" stroke-width="1.4" stroke-linecap="round" fill="none"/>
        <path d="M40 50C44 46 49 44 52 43" stroke="#f5f0e8" stroke-width="1.4" stroke-linecap="round" fill="none"/>
        <circle cx="40" cy="20" r="4" fill="#a0785a"/>
        <text x="92" y="38" font-family="'Space Grotesk', sans-serif" font-weight="700" font-size="30" letter-spacing="-0.5">
          <tspan fill="#1a1a16">Plant</tspan><tspan fill="#2d6a4f">Safe</tspan>
        </text>
        <text x="92" y="58" font-family="'DM Sans', sans-serif" font-weight="300" font-size="11" fill="#a89e90" letter-spacing="2">
          URBAN FORAGING GUIDE
        </text>
        <line x1="92" y1="63" x2="220" y2="63" stroke="#a0785a" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
      </svg>

      <!-- Description -->
      <p class="text-sm text-brand-sub text-center leading-relaxed max-w-[260px]">
        Discover edible plants near you in Vancouver
      </p>

    </div>

    <!-- Bottom: Buttons -->
    <div class="w-full flex flex-col gap-3 max-w-sm">

      <!-- Log In -->
      <a href="/login"
         class="w-full bg-brand-charcoal text-white text-sm font-medium
                text-center py-4 rounded-full hover:opacity-90 transition-opacity">
        Log In
      </a>

      <!-- Register -->
      <a href="/signup"
         class="w-full bg-white text-brand-text text-sm font-medium
                text-center py-4 rounded-full border border-brand-border
                hover:bg-brand-alt transition-colors">
        Register
      </a>

      <!-- Continue as guest -->
      <a href="/map"
         class="w-full text-brand-muted text-sm text-center py-2
                hover:text-brand-sub transition-colors">
        Continue as guest
      </a>

    </div>

  </div>

</body>
</html>