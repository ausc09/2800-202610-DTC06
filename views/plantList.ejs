<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head") %>
    <title>Edible Plants · PlantSafe</title>
</head>

<body class="bg-brand-bg font-body text-brand-text">

  <div class="px-5 pt-6 pb-2 flex justify-between items-center">
    <h1 class="font-display font-bold text-2xl text-brand-text">Edible Plants</h1>
    <button class="bg-brand-alt rounded-xl p-2">
      <i class="fa-solid fa-bars text-brand-sub"></i>
    </button>
  </div>

  <%- include("partials/searchbar", {
  placeholder: "Search plants...",
  screen: "plants",
  search: search || ""
}) %>

   <%
  function makeFilterUrl(overrides = {}) {
    const params = new URLSearchParams();

    const nextVerified = overrides.verified ?? verified;
    const nextInSeason = overrides.inSeason ?? inSeason;
    const nextSafeOnly = overrides.safeOnly ?? safeOnly;

    if (nextVerified) params.set("verified", "true");
    if (nextInSeason) params.set("inSeason", "true");
    if (nextSafeOnly) params.set("safeOnly", "true");

    if (search) params.set("search", search);

    return `/plants/1${params.toString() ? `?${params.toString()}` : ""}`;
  }
%>

<div class="flex gap-2 px-4 pb-3 overflow-x-auto">
  <button
    onclick="window.location.href='/plants/1'"
    class="<%= !verified && !inSeason && !safeOnly ? 'bg-brand-charcoal text-white' : 'bg-brand-alt text-brand-sub' %> text-xs font-semibold px-4 py-2 rounded-full"
  >
    All
  </button>

  <button
    onclick="window.location.href='<%= makeFilterUrl({ verified: !verified }) %>'"
    class="<%= verified ? 'bg-brand-charcoal text-white' : 'bg-brand-alt text-brand-sub' %> text-xs font-semibold px-4 py-2 rounded-full"
  >
    Verified
  </button>

  <button
    onclick="window.location.href='<%= makeFilterUrl({ inSeason: !inSeason }) %>'"
    class="<%= inSeason ? 'bg-brand-charcoal text-white' : 'bg-brand-alt text-brand-sub' %> text-xs font-semibold px-4 py-2 rounded-full"
  >
    In Season
  </button>

  <button
    onclick="window.location.href='<%= makeFilterUrl({ safeOnly: !safeOnly }) %>'"
    class="<%= safeOnly ? 'bg-brand-charcoal text-white' : 'bg-brand-alt text-brand-sub' %> text-xs font-semibold px-4 py-2 rounded-full"
  >
    Safe Only
  </button>
</div>

    <p class="px-5 text-xs text-brand-muted font-semibold tracking-widest mb-3">
      <%= plants.length %> PLANTS NEAR YOU
    </p>

    <div class="px-4 flex flex-col gap-3">
      <% plants.forEach(plant=> { %>
        <a href="/plant/<%= plant._id %>" class="block">
          <%- include("partials/plantcard", { plant }) %>
        </a>
        <% }) %>
    </div>
    <div class="flex items-center justify-center pb-24 mt-5 gap-2">
      <%
  const params = new URLSearchParams();

  if (verified) params.set("verified", "true");
  if (inSeason) params.set("inSeason", "true");
  if (safeOnly) params.set("safeOnly", "true");
  if (type && type !== "all") params.set("type", type);
  if (search) params.set("search", search);

  const paginationQuery = params.toString() ? `?${params.toString()}` : "";
%>

      <% if (page !== 1) { %>
        <button
          onclick="window.location.href='/plants/1<%= paginationQuery %>'"
          class="bg-brand-alt text-brand-sub text-xs font-semibold px-4 py-2 rounded-full hover:bg-brand-greenMid hover:text-white"
        >
          First
        </button>
      <% } %>

      <button
        onclick="window.location.href='/plants/<%= page - 1 %><%= paginationQuery %>'"
        <%= page === 1 ? "disabled" : "" %>
        class="bg-brand-alt text-brand-sub text-xs font-semibold px-4 py-2 rounded-full hover:bg-brand-greenMid hover:text-white disabled:opacity-40 disabled:pointer-events-none"
      >
        Previous
      </button>

      <span class="text-xs text-brand-muted px-2">
        Page <%= page %> of <%= totalPages %>
      </span>

      <button
        onclick="window.location.href='/plants/<%= page + 1 %><%= paginationQuery %>'"
        <%= page === totalPages ? "disabled" : "" %>
        class="bg-brand-alt text-brand-sub text-xs font-semibold px-4 py-2 rounded-full hover:bg-brand-greenMid hover:text-white disabled:opacity-40 disabled:pointer-events-none"
      >
        Next
      </button>

      <% if (page !== totalPages) { %>
        <button
          onclick="window.location.href='/plants/<%= totalPages %><%= paginationQuery %>'"
          class="bg-brand-alt text-brand-sub text-xs font-semibold px-4 py-2 rounded-full hover:bg-brand-greenMid hover:text-white"
        >
          Last
        </button>
      <% } %>
    </div>

    <%- include("partials/bottomnav") %>
  </body>
</html>