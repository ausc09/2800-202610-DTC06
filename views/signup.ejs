<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign up · PlantSafe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              bg:          '#f7f5f0',
              surface:     '#ffffff',
              alt:         '#f0ede6',
              border:      '#e0dbd2',
              borderLight: '#eae6de',
              text:        '#1a1a16',
              sub:         '#6b6456',
              muted:       '#a89e90',
              green:       '#2d6a4f',
              greenMid:    '#40916c',
              greenPale:   '#e8f5ee',
              brown:       '#8c6a50',
              brownPale:   '#f5ede4',
              charcoal:    '#2a2620',
            }
          },
          fontFamily: {
            display: ["'Space Grotesk'", 'sans-serif'],
            body:    ["'DM Sans'", 'sans-serif'],
          },
          borderRadius: {
            card: '14px',
            chip: '20px',
            btn:  '13px',
          },
          boxShadow: {
            card: '0 2px 16px rgba(40,30,20,0.08)',
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-brand-bg min-h-screen flex items-center justify-center font-body">

  <div class="bg-brand-bg w-full min-h-screen flex flex-col justify-center px-8 py-10
              sm:min-h-fit sm:max-w-sm sm:rounded-card sm:shadow-card sm:flex-none sm:bg-brand-surface">

    <!-- back button -->
    <button onclick="history.back()"
      class="text-brand-sub mb-6 block hover:text-brand-text transition bg-brand-alt rounded-xl p-2 w-fit">
      <i data-lucide="arrow-left" class="w-5 h-5"></i>
    </button>


    <!-- title -->
    <h1 class="font-display text-center font-bold text-brand-text text-2xl mb-8">Create account</h1>


    <!-- First Name -->
<div class="mb-4">
  <label class="block text-xs font-semibold text-brand-text tracking-widest mb-2">FIRST NAME</label>
  <input id="firstName" type="text" placeholder="Enter your first name"
    class="w-full bg-brand-surface border border-brand-border rounded-xl px-4 py-3 text-brand-text placeholder:text-brand-muted text-sm focus:outline-none focus:border-brand-green">
</div>

<!-- Last Name -->
<div class="mb-4">
  <label class="block text-xs font-semibold text-brand-text tracking-widest mb-2">LAST NAME</label>
  <input id="lastName" type="text" placeholder="Enter your last name"
    class="w-full bg-brand-surface border border-brand-border rounded-xl px-4 py-3 text-brand-text placeholder:text-brand-muted text-sm focus:outline-none focus:border-brand-green">
</div>

    <!-- Email -->
    <div class="mb-4">
      <label class="block text-xs font-semibold text-brand-text tracking-widest mb-2">EMAIL</label>
      <input id="email" type="email" placeholder="Enter your email"
        class="w-full bg-brand-surface border border-brand-border rounded-xl px-4 py-3 text-brand-text placeholder:text-brand-muted text-sm focus:outline-none focus:border-brand-green">
    </div>

    <!-- Password -->
    <div class="mb-4">
      <label class="block text-xs font-semibold text-brand-text tracking-widest mb-2">PASSWORD</label>
      <input id="password" type="password" placeholder="Enter your password"
        class="w-full bg-brand-surface border border-brand-border rounded-xl px-4 py-3 text-brand-text placeholder:text-brand-muted text-sm focus:outline-none focus:border-brand-green">
    </div>


    <!-- Error -->
    <p id="err" class="text-red-500 text-sm mb-4 hidden"></p>

    <!-- Sign up button -->
    <button onclick="signup()"
      class="w-full bg-brand-charcoal text-white font-body font-semibold py-4 rounded-btn hover:bg-brand-green transition mt-2 mb-4">
      Create Account
    </button>

    <!-- Login link -->
    <p class="text-center text-sm text-brand-sub">
      Already have an account?
      <a href="/login" class="text-brand-text font-bold hover:text-brand-green">Login</a>
    </p>

  </div>

  <script src="https://unpkg.com/lucide@latest"></script>
  <script>lucide.createIcons();</script>
  <script src="/js/signup.js"></script>
</body>
</html>