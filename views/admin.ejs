<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head") %>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-brand-bg font-body text-brand-text min-h-screen">

  <div class="max-w-2xl mx-auto px-6 py-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="font-display font-bold text-2xl">Admin Dashboard</h1>
        <p class="text-sm text-brand-sub mt-1">Manage users and reviews</p>
      </div>
      <button onclick="window.location.href='/'"
        class="flex items-center gap-2 text-sm text-brand-sub hover:text-brand-green transition">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Back
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 gap-4 mb-8">
      <div class="bg-brand-surface border border-brand-border rounded-2xl p-4">
        <p class="text-xs text-brand-muted tracking-widest mb-1">TOTAL USERS</p>
        <p class="font-display font-bold text-3xl" id="total-users">—</p>
      </div>
      <div class="bg-brand-surface border border-brand-border rounded-2xl p-4">
        <p class="text-xs text-brand-muted tracking-widest mb-1">ADMINS</p>
        <p class="font-display font-bold text-3xl" id="total-admins">—</p>
      </div>
    </div>

    <!-- Users Table -->
    <div class="bg-brand-surface border border-brand-border rounded-2xl overflow-hidden mb-8">
      <div class="px-4 py-3 border-b border-brand-border flex items-center justify-between">
        <p class="text-xs font-semibold text-brand-muted tracking-widest">ALL USERS</p>
        <input id="search" type="text" placeholder="Search by name or email..."
          onkeyup="filterUsers()"
          class="bg-brand-alt border border-brand-border rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:border-brand-green w-48">
      </div>

      <div id="users-list">
        <div class="px-4 py-8 text-center text-brand-muted text-sm">Loading...</div>
      </div>
    </div>

  </div>

  <!-- Edit Role Modal -->
  <div id="modal" class="hidden fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50">
    <div class="bg-brand-surface rounded-2xl p-6 w-80 mx-4">
      <h3 class="font-display font-bold text-lg mb-4">Edit User Role</h3>
      <p class="text-sm text-brand-sub mb-4" id="modal-name"></p>
      <select id="modal-role"
        class="w-full bg-brand-alt border border-brand-border rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-green mb-4">
        <option value="user">User</option>
        <option value="admin">Admin</option>
      </select>
      <div class="flex gap-3">
        <button onclick="closeModal()"
          class="flex-1 border border-brand-border text-brand-sub py-3 rounded-xl text-sm hover:bg-brand-alt transition">
          Cancel
        </button>
        <button onclick="saveRole()"
          class="flex-1 bg-brand-charcoal text-white py-3 rounded-xl text-sm hover:bg-brand-green transition">
          Save
        </button>
      </div>
    </div>
  </div>

  <script>lucide.createIcons();</script>
  <script src="/js/admin.js"></script>
</body>
</html>