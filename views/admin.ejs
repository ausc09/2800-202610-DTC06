<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body class="min-h-screen font-body text-brand-text bg-brand-bg">
    <div class="max-w-2xl mx-auto px-6 py-8">
      <!-- Header -->
      <div class="flex mb-8 items-center justify-between">
        <div>
          <h1 class="font-display font-bold text-2xl">Admin Dashboard</h1>
          <p class="mt-1 text-sm text-brand-sub">Manage users and reviews</p>
        </div>
        <button
          onclick="window.location.href='/'"
          class="flex text-sm text-brand-sub items-center gap-2 hover:text-brand-green transition"
        >
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          Back
        </button>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 mb-8 gap-4">
        <div
          class="p-4 bg-brand-surface border border-brand-border rounded-2xl"
        >
          <p class="mb-1 text-xs text-brand-muted tracking-widest">
            TOTAL USERS
          </p>
          <p class="font-display font-bold text-3xl" id="total-users">—</p>
        </div>
        <div
          class="p-4 bg-brand-surface border border-brand-border rounded-2xl"
        >
          <p class="mb-1 text-xs text-brand-muted tracking-widest">ADMINS</p>
          <p class="font-display font-bold text-3xl" id="total-admins">—</p>
        </div>
      </div>

      <!-- Users Table -->
      <div
        class="overflow-hidden mb-8 bg-brand-surface border border-brand-border rounded-2xl"
      >
        <div
          class="flex px-4 py-3 border-b border-brand-border items-center justify-between"
        >
          <p class="text-xs font-semibold text-brand-muted tracking-widest">
            ALL USERS
          </p>
          <input
            id="search"
            type="text"
            placeholder="Search by name or email..."
            onkeyup="filterUsers()"
            class="w-48 px-3 py-1.5 text-xs bg-brand-alt border border-brand-border rounded-xl focus:outline-none focus:border-brand-green"
          />
        </div>

        <div id="users-list" class="overflow-y-auto max-h-96">
          <div class="px-4 py-8 text-center text-brand-muted text-sm">
            Loading...
          </div>
        </div>
      </div>
      <!-- Reviews Table -->
      <div
        class="overflow-hidden mb-8 bg-brand-surface border border-brand-border rounded-2xl"
      >
        <div
          class="flex px-4 py-3 border-b border-brand-border items-center justify-between"
        >
          <p class="text-xs font-semibold text-brand-muted tracking-widest">
            ALL REVIEWS
          </p>
          <input
            id="search-review"
            type="text"
            placeholder="Search reviews..."
            onkeyup="filterReviews()"
            class="w-48 px-3 py-1.5 text-xs bg-brand-alt border border-brand-border rounded-xl focus:outline-none focus:border-brand-green"
          />
        </div>
        <div id="reviews-list" class="overflow-y-auto max-h-96">
          <div class="px-4 py-8 text-center text-brand-muted text-sm">
            Loading...
          </div>
        </div>
      </div>
    </div>

    <!-- Edit Role Modal -->
    <div
      id="modal"
      class="hidden flex z-50 bg-black bg-opacity-40 fixed inset-0 items-center justify-center"
    >
      <div class="w-80 p-6 mx-4 bg-brand-surface rounded-2xl">
        <h3 class="mb-4 font-display font-bold text-lg">Edit User Role</h3>
        <p class="mb-4 text-sm text-brand-sub" id="modal-name"></p>
        <select
          id="modal-role"
          class="w-full px-4 py-3 mb-4 text-sm bg-brand-alt border border-brand-border rounded-xl focus:outline-none focus:border-brand-green"
        >
          <option value="user">User</option>
          <option value="admin">Admin</option>
        </select>
        <div class="flex gap-3">
          <button
            onclick="closeModal()"
            class="flex-1 py-3 text-brand-sub text-sm border border-brand-border rounded-xl hover:bg-brand-alt transition"
          >
            Cancel
          </button>
          <button
            onclick="saveRole()"
            class="flex-1 py-3 text-white text-sm bg-brand-charcoal rounded-xl hover:bg-brand-green transition"
          >
            Save
          </button>
        </div>
      </div>
    </div>
    <script>
      lucide.createIcons();
    </script>
    <script src="/js/admin.js"></script>
  </body>
</html>
