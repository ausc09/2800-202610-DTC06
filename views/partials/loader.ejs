<div
  id="<%= id || 'loader' %>"
  class="hidden fixed inset-0 z-[2000] bg-black/20 backdrop-blur-sm flex items-center justify-center"
>
  <div
    class="bg-brand-surface rounded-2xl px-5 py-4 shadow-card flex items-center gap-3"
  >
    <div
      class="w-5 h-5 border-2 border-brand-green border-t-transparent rounded-full animate-spin"
    ></div>

    <p class="text-sm font-semibold text-brand-text">
      <%= message || 'Loading...' %>
    </p>
  </div>
</div>
