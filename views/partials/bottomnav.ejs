<!-- views/partials/bottomnav.ejs -->

<!--fix the nav bar in bottom-->
<nav class="fixed bottom-0 left-0 right-0 z-50
            bg-brand-surface border-t border-brand-border
            pb-[env(safe-area-inset-bottom)]">
  <div class="flex justify-around items-center h-16 max-w-screen-lg mx-auto">

    <!-- Map tab -->
    <a href="/map" class="nav-tab group flex flex-col items-center justify-center gap-1 flex-1 py-2"
       data-page="map">
      <svg class="w-6 h-6 text-brand-muted group-[.active]:text-brand-green transition-colors"
           fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
        <circle cx="12" cy="9" r="2.5"/>
      </svg>
      <span class="text-[11px] text-brand-muted group-[.active]:text-brand-green
                   group-[.active]:font-medium transition-colors">
        Map
      </span>
    </a>

    <!-- Plants tab -->
    <a href="/plants" class="nav-tab group flex flex-col items-center justify-center gap-1 flex-1 py-2"
       data-page="plants">
      <svg class="w-6 h-6 text-brand-muted group-[.active]:text-brand-green transition-colors"
           fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M12 22V12"/>
        <path d="M12 12C12 8 16 4 20 4c0 4-4 8-8 8z"/>
        <path d="M12 16C12 13 8 9 4 9c0 4 4 7 8 7z"/>
      </svg>
      <span class="text-[11px] text-brand-muted group-[.active]:text-brand-green
                   group-[.active]:font-medium transition-colors">
        Plants
      </span>
    </a>

    <!-- Saved tab -->
    <a href="/saved" class="nav-tab group flex flex-col items-center justify-center gap-1 flex-1 py-2"
       data-page="saved">
      <svg class="w-6 h-6 text-brand-muted group-[.active]:text-brand-green transition-colors"
           fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
      </svg>
      <span class="text-[11px] text-brand-muted group-[.active]:text-brand-green
                   group-[.active]:font-medium transition-colors">
        Saved
      </span>
    </a>

    <!-- Profile tab -->
    <a href="/profile" class="nav-tab group flex flex-col items-center justify-center gap-1 flex-1 py-2"
       data-page="profile">
      <svg class="w-6 h-6 text-brand-muted group-[.active]:text-brand-green transition-colors"
           fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <circle cx="12" cy="8" r="4"/>
        <path d="M20 21a8 8 0 00-16 0"/>
      </svg>
      <span class="text-[11px] text-brand-muted group-[.active]:text-brand-green
                   group-[.active]:font-medium transition-colors">
        Profile
      </span>
    </a>

  </div>
</nav>

<!-- Spacer: prevents page content from being hidden behind the fixed nav -->
<div class="h-16 pb-[env(safe-area-inset-bottom)]"></div>

<script>
// Auto-highlight the current page tab based on URL path
document.addEventListener("DOMContentLoaded", () => {
  const path = window.location.pathname;
  document.querySelectorAll(".nav-tab").forEach(tab => {
    const page = tab.dataset.page;
    if (
      path.startsWith("/" + page) ||
      (page === "plants" && path.startsWith("/plant"))  // ← 加呢行
    ) {
      tab.classList.add("active");
    }
  });
});
</script>