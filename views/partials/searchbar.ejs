<div
  class="flex items-center gap-2 px-4 py-3"
  data-search-screen="<%= screen %>"
>
  <div class="relative flex-1">
    <div class="flex items-center gap-2 bg-brand-surface rounded-full px-4 py-2.5">
      <svg class="w-4 h-4 text-brand-muted flex-shrink-0" fill="none"
           stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        id="searchInput"
        type="text"
        value="<%= search || '' %>"
        placeholder="<%= placeholder %>"
        class="bg-transparent text-sm text-brand-text placeholder-brand-muted outline-none w-full"
      />
      <button
        id="searchButton"
        class="hidden bg-brand-charcoal text-white text-xs font-semibold px-4 py-2 rounded-xl hover:bg-brand-greenMid transition shrink-0"
      >
        Search
      </button>
    </div>
  </div>
</div>
<script src="/js/searchbar.js"></script>
