<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head") %>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-brand-bg font-body text-brand-text min-h-screen flex items-center justify-center">

  <div class="bg-brand-bg w-full min-h-screen flex flex-col justify-center px-8 py-10
              sm:min-h-fit sm:max-w-sm sm:rounded-2xl sm:shadow-sm sm:flex-none sm:bg-brand-surface">

    <!-- Title -->
    <h1 class="font-display font-bold text-2xl mb-1">Two-factor verification</h1>
    <p class="text-sm text-brand-sub mb-8">Open your authenticator app and enter the 6-digit code.</p>

    <!-- Code input -->
    <div class="mb-6">
      <label class="block text-xs font-semibold text-brand-text tracking-widest mb-2">6-DIGIT CODE</label>
      <input id="token" type="text" placeholder="000000" maxlength="6" inputmode="numeric"
        class="w-full bg-brand-surface border border-brand-border rounded-xl px-4 py-3 text-brand-text placeholder:text-brand-muted text-sm focus:outline-none focus:border-brand-green tracking-widest text-center text-lg">
    </div>

    <!-- Error -->
    <p id="err" class="text-red-500 text-sm mb-4 hidden"></p>

    <!-- Verify button -->
    <button onclick="verify2FA()"
      class="w-full bg-brand-charcoal text-white font-body font-semibold py-4 rounded-xl hover:bg-brand-green transition">
      Verify
    </button>

  </div>

  <script>lucide.createIcons();</script>
  <script src="/js/verify-2fa.js"></script>
</body>
</html>